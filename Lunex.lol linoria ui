--=========================================================
-- Helpers
--=========================================================
local function create(class, props)
	local inst = Instance.new(class)
	props = props or {}
	for k, v in next, props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function addCorner(obj, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = obj })
	return obj
end

local function addStroke(obj, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or Theme.Outline,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

local function tween(obj, props, time, style, dir)
	local t = TweenService:Create(obj,
		TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props)
	t:Play()
	return t
end

--=========================================================
-- Signal
--=========================================================
local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ _handlers = {} }, Signal) end
function Signal:Connect(fn)
	table.insert(self._handlers, fn)
	return {
		Disconnect = function()
			local i = table.find(self._handlers, fn)
			if i then table.remove(self._handlers, i) end
		end,
	}
end
function Signal:Fire(...)
	for _, fn in ipairs(self._handlers) do task.spawn(fn, ...) end
end

--=========================================================
-- GUI parent
