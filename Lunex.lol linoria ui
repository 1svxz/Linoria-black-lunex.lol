	window.Flags = {}
	window.Configs = {}

	local Tabs = window.Tabs
	local SelectedTab

	local function selectTab(tab)
		if SelectedTab == tab then return end
		if SelectedTab then
			SelectedTab.Container.Visible = false
			SelectedTab.Underline.Visible = false
			tween(SelectedTab.Button, { BackgroundTransparency = 1 })
			SelectedTab.Button.TextColor3 = Theme.DimText
		end
		SelectedTab = tab
		tab.Container.Visible = true
		tab.Underline.Visible = true
		tween(tab.Button, { BackgroundTransparency = 0 })
		tab.Button.TextColor3 = Theme.Text
		closeActivePopup()
	end

	local function setMinimized(state)
		minimized = state
		local w = Main.AbsoluteSize.X
		if w <= 0 then w = winW end
		if minimized then
			TabBar.Visible = false
			Content.Visible = false
			tween(Main, { Size = UDim2.fromOffset(w, Sizes.Topbar) }, 0.2, Enum.EasingStyle.Quart)
		else
			TabBar.Visible = true
			Content.Visible = true
			tween(Main, { Size = winSize }, 0.2, Enum.EasingStyle.Quart)
		end
	end

	makeCtrlButton("-", IS_MOBILE and -54 or -44, function()
		setMinimized(not minimized)
	end)
	makeCtrlButton("x", IS_MOBILE and -14 or -12, function()
		if window.AutoSave and window.LastConfigName then
			pcall(function() window:SaveConfig(window.LastConfigName) end)
		end
		ScreenGui:Destroy()
	end)

	--=========================
	-- Notifications
	--=========================
	function window:Notify(cfg)
		if type(cfg) == "string" then cfg = { Text = cfg } end
		return notify(cfg)
	end

	--=========================
	-- Config save/load
	--=========================
	local configDir = "LinoriaBlack"
	local hasFS = typeof(writefile) == "function" and typeof(readfile) == "function"

	local function configPath(name)
		return configDir .. "/" .. tostring(name) .. ".json"
	end

	if hasFS and typeof(isfolder) == "function" and typeof(makefolder) == "function" then
		if not isfolder(configDir) then makefolder(configDir) end
	end

	function window:SaveConfig(name)
		name = tostring(name or "default")
		window.LastConfigName = name

		local data = {}
		for flag, entry in pairs(self.Flags) do
			local ok, v = pcall(entry.getter)
			if ok and v ~= nil then data[flag] = encodeValue(v) end
		end

		self.Configs[name] = data

		if hasFS then
			local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
			if ok then pcall(writefile, configPath(name), encoded) end
		end
		return data
	end

	function window:LoadConfig(name)
		name = tostring(name or "default")
		window.LastConfigName = name

		local data = self.Configs[name]
		if not data and hasFS and typeof(isfile) == "function" and isfile(configPath(name)) then
			local ok, content = pcall(readfile, configPath(name))
			if ok then
				local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, content)
				if ok2 then data = decoded end
			end
		end
		if not data then return false end

		self.Configs[name] = data
		for flag, value in pairs(data) do
			local entry = self.Flags[flag]
			if entry then
				pcall(entry.setter, decodeValue(value))
			end
		end
		return true
	end

	function window:DeleteConfig(name)
		name = tostring(name or "default")
		self.Configs[name] = nil
		if hasFS and typeof(isfile) == "function" and typeof(delfile) == "function" then
			if isfile(configPath(name)) then pcall(delfile, configPath(name)) end
		end
	end

	function window:ListConfigs()
		local out = {}
		if hasFS and typeof(listfiles) == "function" then
			for _, path in ipairs(listfiles(configDir)) do
				local n = path:match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
		for n in pairs(self.Configs) do
			if not table.find(out, n) then out[#out + 1] = n end
		end
		return out
	end

	--=========================
