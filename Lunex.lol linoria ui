-- Toggle
-----------------------------------------------------------
function TabMethods:CreateToggle(config)
	config = config or {}
	local value = config.Default == true
	local changed = Signal.new()
	local obj = {}

	local holder = create("TextButton", {
		Parent = self:_page(),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Sizes.Element),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self:_nextOrder(),
		ZIndex = 6,
	})
	addCorner(holder, 6)
	addStroke(holder, Theme.Outline)

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.7, 0, 1, 0),
		Font = Theme.Font,
		Text = tostring(config.Text or "Toggle"),
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	local track = create("Frame", {
		Parent = holder,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(IS_MOBILE and 44 or 34, IS_MOBILE and 22 or 18),
		BackgroundColor3 = Theme.Black,
		BorderSizePixel = 0,
		ZIndex = 6,
	})
	addCorner(track, 9)
	local trackStroke = addStroke(track, Theme.Accent, 1.5, 0.55)

	local knob = create("Frame", {
		Parent = track,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = IS_MOBILE and UDim2.fromOffset(18, 18) or UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.DimText,
		BorderSizePixel = 0,
		ZIndex = 7,
	})
	addCorner(knob, 9)

	local knobOffX = 2
	local knobOnX = (IS_MOBILE and 44 or 34) - (IS_MOBILE and 18 or 14) - 2

	local function setValue(v, silent)
		v = v and true or false
		value = v
		obj.Value = v
		tween(knob, {
			Position = UDim2.new(0, v and knobOnX or knobOffX, 0.5, 0),
			BackgroundColor3 = v and Theme.Accent or Theme.DimText,
		}, 0.15)
		tween(trackStroke, { Transparency = v and 0 or 0.55 }, 0.15)
		if not silent then changed:Fire(v) end
	end

	holder.MouseEnter:Connect(function()
		tween(holder, { BackgroundColor3 = Theme.ElementHi })
	end)
	holder.MouseLeave:Connect(function()
		tween(holder, { BackgroundColor3 = Theme.Element })
	end)
	holder.MouseButton1Click:Connect(function() setValue(not value) end)

	if config.Callback then changed:Connect(config.Callback) end

	obj.Instance = holder
	obj.SetValue = function(_, v) setValue(v) end
	obj.GetValue = function() return value end
	obj.OnChanged = function(_, fn) return changed:Connect(fn) end
	obj.Value = value

	Tooltip.attach(holder, config.Tooltip)
	self:_registerFlag(config, obj, "toggle")

	setValue(value, true)
	return obj
end

-----------------------------------------------------------
-- Slider
-----------------------------------------------------------
function TabMethods:CreateSlider(config)
	config = config or {}
	local min      = config.Min or 0
	local max      = config.Max or 100
	local decimals = config.Decimals or 0
	local suffix   = config.Suffix or ""
	local value    = config.Default or min
	local changed  = Signal.new()
	local obj      = {}

	local holder = create("TextButton", {
		Parent = self:_page(),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Sizes.Slider),
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		LayoutOrder = self:_nextOrder(),
		ZIndex = 6,
	})
	addCorner(holder, 6)
	addStroke(holder, Theme.Outline)

	local fill = create("Frame", {
		Parent = holder,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 6,
	})

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.55, 0, 1, 0),
		Font = Theme.Font,
		Text = tostring(config.Text or "Slider"),
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
	})

	local valueBox = create("TextBox", {
		Parent = holder,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.new(0.4, -6, 1, -10),
		BackgroundColor3 = Theme.Black,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Font = Theme.Font,
		Text = "",
		TextColor3 = Theme.DimText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		ClearTextOnFocus = false,
		ZIndex = 8,
	})
	addCorner(valueBox, 4)
	addStroke(valueBox, Theme.Outline, 1, 0.5)

	local function round(n)
		local mult = 10 ^ decimals
		return math.floor(n * mult + 0.5) / mult
	end

	local function setValue(v, silent)
		v = math.clamp(round(tonumber(v) or min), min, max)
		value = v
		obj.Value = v
		local alpha = (max - min == 0) and 0 or (v - min) / (max - min)
		tween(fill, { Size = UDim2.new(alpha, 0, 1, 0) }, 0.08)
		valueBox.Text = tostring(v) .. suffix
		if not silent then changed:Fire(v) end
	end

	local dragging = false

	local function updateFromInput(input)
		local width = holder.AbsoluteSize.X
		if width <= 0 then return end
		local rel = math.clamp((input.Position.X - holder.AbsolutePosition.X) / width, 0, 1)
		setValue(min + (max - min) * rel)
	end

	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			self:_freezeScroll()
			updateFromInput(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			updateFromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				self:_unfreezeScroll()
			end
		end
	end)

	valueBox.FocusLost:Connect(function()
		local num = tonumber(valueBox.Text:gsub("%D", ""))
		if num then
			setValue(num)
		else
			setValue(value, true)
		end
	end)
	valueBox.Focused:Connect(function()
		dragging = false
	end)

	if config.Callback then changed:Connect(config.Callback) end

	obj.Instance = holder
	obj.SetValue = function(_, v) setValue(v) end
	obj.GetValue = function() return value end
	obj.OnChanged = function(_, fn) return changed:Connect(fn) end

	Tooltip.attach(holder, config.Tooltip)
	self:_registerFlag(config, obj, "slider")

	setValue(value, true)
	return obj
end

