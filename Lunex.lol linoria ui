		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local bar = create("TextButton", {
		Parent = row,
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Text = "",
