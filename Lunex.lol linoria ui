	--=========================
	-- Sub-tabs
	--=========================
	function TabMethods:CreateSubTab(name)
		local tab = self

		if not tab._subTabBar then
			local bar = create("ScrollingFrame", {
				Parent = tab.Container,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.new(1, 0, 0, Sizes.SubTabBar),
				ScrollBarThickness = 0,
				ScrollingDirection = Enum.ScrollingDirection.X,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.X,
				BorderSizePixel = 0,
				ZIndex = 8,
			})
			create("UIListLayout", {
				Parent = bar,
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 4),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			})
			create("UIPadding", {
				Parent = bar,
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
			})
			tab._subTabBar = bar

			tab.Page.Position = UDim2.fromOffset(0, Sizes.SubTabBar)
			tab.Page.Size = UDim2.new(1, 0, 1, -Sizes.SubTabBar)
		end

		local page = create("ScrollingFrame", {
			Parent = tab.Container,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, Sizes.SubTabBar),
			Size = UDim2.new(1, 0, 1, -Sizes.SubTabBar),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Outline,
			Visible = false,
			BorderSizePixel = 0,
			ZIndex = 5,
		})
		create("UIListLayout", {
			Parent = page,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		create("UIPadding", {
			Parent = page,
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		})

		local subBtn = create("TextButton", {
			Parent = tab._subTabBar,
			BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(0, Sizes.SubTab),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Theme.Font,
			Text = "  " .. tostring(name) .. "  ",
			TextColor3 = Theme.DimText,
			TextSize = 12,
			AutoButtonColor = false,
			ZIndex = 8,
		})
		addCorner(subBtn, 6)

		local sub = setmetatable({}, { __index = TabMethods })
		sub.Name = name
		sub._order = 0
		sub.ScreenGui = tab.ScreenGui
		sub.Window = tab.Window
		sub.Main = tab.Main
		sub.ParentTab = tab
		sub.Page = page
		sub._activePage = page
		sub.Button = subBtn

		local function selectSub()
			for _, s in ipairs(tab._subTabs) do
				s.Page.Visible = false
				s.Button.BackgroundTransparency = 1
				s.Button.TextColor3 = Theme.DimText
			end
			tab.Page.Visible = false

			sub.Page.Visible = true
			subBtn.BackgroundTransparency = 0
			subBtn.TextColor3 = Theme.Text

			tab._activeSubTab = sub
			tab._activePage = sub.Page
			closeActivePopup()
		end

		subBtn.MouseButton1Click:Connect(selectSub)
		table.insert(tab._subTabs, sub)

		if #tab._subTabs == 1 then
			selectSub()
		end

		return sub
	end

	function TabMethods:SelectSubTab(nameOrIndex)
		local list = self._subTabs
		if not list then return end
		local target
		if type(nameOrIndex) == "number" then
			target = list[nameOrIndex]
		else
			for _, s in ipairs(list) do
				if s.Name == nameOrIndex then target = s break end
			end
		end
		if target then target.Button:Fire("MouseButton1Click") end
	end

	function window:SelectTab(index)
		local tab = Tabs[index]
		if tab then selectTab(tab) end
	end

	function window:Toggle()
		Main.Visible = not Main.Visible
		if not Main.Visible then
			closeActivePopup()
			if Tooltip._frame then Tooltip._frame.Visible = false end
		end
	end

	function window:Destroy()
		closeActivePopup()
		if window.AutoSave and window.LastConfigName then
			pcall(function() window:SaveConfig(window.LastConfigName) end)
		end
		ScreenGui:Destroy()
	end

	--=========================
	-- Dragging
	--=========================
	do
		local dragging, dragStart, startPos
		Topbar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Main.Position
				closeActivePopup()
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - dragStart
				Main.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		Topbar.InputBegan:Connect(function(input)
			if minimized and (input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch) then
				setMinimized(false)
			end
		end)
	end

	--=========================
	-- Resize handle
	--=========================
	do
		local Handle = create("TextButton", {
			Parent = Main,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -2, 1, -2),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 20,
			AutoButtonColor = false,
		})
		for i = 1, 3 do
			create("Frame", {
				Parent = Handle,
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -(i * 3), 1, -3),
				Size = UDim2.fromOffset(i * 3, 2),
				BackgroundColor3 = Theme.Outline,
				BorderSizePixel = 0,
				Rotation = -45,
				ZIndex = 20,
			})
		end

		local resizing, resizeStart, startSize
		Handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				startSize = Main.AbsoluteSize
				closeActivePopup()
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not resizing then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - resizeStart
				local vp2 = viewport()
				local newW = math.clamp(startSize.X + delta.X, 320, vp2.X * 0.95)
				local newH = math.clamp(startSize.Y + delta.Y, 220, vp2.Y * 0.9)
				Main.Size = UDim2.fromOffset(newW, newH)
				winSize = UDim2.fromOffset(newW, newH)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				resizing = false
			end
		end)
	end

	--=========================
	-- Toggle key
	--=========================
	if not IS_MOBILE then
		UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.KeyCode == toggleKey then
				window:Toggle()
			end
		end)
	end

	return window
end

return LinoriaBlack
