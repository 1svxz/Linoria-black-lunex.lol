		ZIndex = 2,
	})
	addCorner(knob, 4)
	return bar, knob, gradient
end

--=========================================================
-- Tab element methods
--=========================================================
local TabMethods = {}

function TabMethods:_nextOrder()
	self._order = (self._order or 0) + 1
	return self._order
end

function TabMethods:_page()
	return self._activePage or self.Page
end

function TabMethods:_registerFlag(config, obj, kind)
	if not config or not config.Flag then return end
	local window = self.Window
	if not window then return end
	window.Flags[config.Flag] = {
		getter = function() return obj:GetValue() end,
		setter = function(v) obj:SetValue(v) end,
		kind = kind,
	}
end

function TabMethods:_freezeScroll()
	local pg = self:_page()
	if pg and pg:IsA("ScrollingFrame") then
		pg.ScrollingEnabled = false
	end
end
function TabMethods:_unfreezeScroll()
	local pg = self:_page()
	if pg and pg:IsA("ScrollingFrame") then
		pg.ScrollingEnabled = true
	end
end

