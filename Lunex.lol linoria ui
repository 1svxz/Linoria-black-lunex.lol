--=========================================================
-- Value serialization (config save/load)
--=========================================================
local function encodeValue(v)
	local t = typeof(v)
	if t == "Color3" then
		return { __t = "Color3", r = v.R, g = v.G, b = v.B }
	elseif t == "EnumItem" then
		return { __t = "EnumItem", enum = tostring(v.EnumType), name = v.Name }
	elseif type(v) == "table" then
		local out = {}
		for k, x in pairs(v) do out[k] = encodeValue(x) end
		return out
	end
	return v
end

local function decodeValue(v)
	if type(v) == "table" then
		if v.__t == "Color3" then
			return Color3.new(v.r, v.g, v.b)
		elseif v.__t == "EnumItem" then
			local enum = Enum[v.enum]
			if enum then return enum[v.name] end
			return nil
		end
		local out = {}
		for k, x in pairs(v) do out[k] = decodeValue(x) end
		return out
	end
	return v
end

--=========================================================
-- Tooltip singleton
--=========================================================
local Tooltip = { _frame = nil, _label = nil, _hideJob = nil }

function Tooltip.init(screenGui)
	Tooltip._frame = create("Frame", {
		Parent = screenGui,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		ZIndex = 2000,
	})
	addCorner(Tooltip._frame, 4)
	addStroke(Tooltip._frame, Theme.Outline)
	create("UIPadding", {
		Parent = Tooltip._frame,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	})
	Tooltip._label = create("TextLabel", {
		Parent = Tooltip._frame,
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Font = Theme.Font,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 12,
	})
end

function Tooltip.attach(holder, text)
	if not text or not Tooltip._frame then return end

	holder.MouseEnter:Connect(function()
		if Tooltip._hideJob then
			pcall(task.cancel, Tooltip._hideJob)
			Tooltip._hideJob = nil
		end
		Tooltip._hideJob = task.delay(0.4, function()
			if not Tooltip._frame or not Tooltip._frame.Parent then return end
			Tooltip._label.Text = tostring(text)
			local mouse = UserInputService:GetMouseLocation()
			Tooltip._frame.Position = UDim2.fromOffset(mouse.X + 14, mouse.Y + 14)
			Tooltip._frame.Visible = true
		end)
	end)

	holder.MouseLeave:Connect(function()
		if Tooltip._hideJob then
			pcall(task.cancel, Tooltip._hideJob)
			Tooltip._hideJob = nil
		end
		if Tooltip._frame then Tooltip._frame.Visible = false end
	end)
end

--=========================================================
-- Notifications
--=========================================================
local function setupNotifications(screenGui)
	local container = create("Frame", {
		Parent = screenGui,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 900,
	})
	create("UIListLayout", {
		Parent = container,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
	})

	local order = 0

	return function(config)
		config = config or {}
		order = order + 1

		local toast = create("Frame", {
			Parent = container,
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 52),
			LayoutOrder = order,
			ClipsDescendants = true,
		})
		addCorner(toast, 6)
		addStroke(toast, Theme.Outline)

		create("Frame", {
			Parent = toast,
			Size = UDim2.new(0, 3, 1, 0),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
		})

		create("TextLabel", {
			Parent = toast,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -20, 0, 16),
			Font = Theme.FontBold,
			Text = tostring(config.Title or "Notification"),
			TextColor3 = Theme.Text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		})

		create("TextLabel", {
			Parent = toast,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 26),
			Size = UDim2.new(1, -20, 0, 20),
			Font = Theme.Font,
			Text = tostring(config.Text or ""),
			TextColor3 = Theme.DimText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
		})

		toast.Position = UDim2.new(1, 30, 0, 0)
		tween(toast, { Position = UDim2.new(0, 0, 0, 0) }, 0.22)

		task.delay(config.Duration or 3, function()
			if not toast.Parent then return end
			tween(toast, { Position = UDim2.new(1, 30, 0, 0) }, 0.2)
			task.wait(0.25)
			if toast.Parent then toast:Destroy() end
		end)

		return toast
	end
end

--=========================================================
-- Spinning gradient
--=========================================================
local function addSpinningGradient(parent, thickness, speed)
	local stroke = create("UIStroke", {
		Color = Theme.Accent,
		Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	local grad = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Theme.GradA),
			ColorSequenceKeypoint.new(0.50, Theme.GradB),
			ColorSequenceKeypoint.new(1.00, Theme.GradA),
		}),
		Rotation = 0,
		Parent = stroke,
	})
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not grad or not grad.Parent then
			conn:Disconnect()
			return
		end
		grad.Rotation = (grad.Rotation + (dt * (speed or 60))) % 360
	end)
	return stroke, grad, conn
end

