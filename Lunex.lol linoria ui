-- Textbox
-----------------------------------------------------------
function TabMethods:CreateTextbox(config)
	config = config or {}
	local changed = Signal.new()
	local obj = {}

	local holder = create("Frame", {
		Parent = self:_page(),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Sizes.Element),
		LayoutOrder = self:_nextOrder(),
		ZIndex = 6,
	})
	addCorner(holder, 6)
	addStroke(holder, Theme.Outline)

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.45, 0, 1, 0),
		Font = Theme.Font,
		Text = tostring(config.Text or "Textbox"),
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	local box = create("TextBox", {
		Parent = holder,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.new(0.5, -6, 1, -10),
		BackgroundColor3 = Theme.Black,
		BorderSizePixel = 0,
		Font = Theme.Font,
		Text = tostring(config.Default or ""),
		PlaceholderText = tostring(config.Placeholder or "Type here..."),
		PlaceholderColor3 = Theme.DimText,
		TextColor3 = Theme.Text,
		TextSize = 12,
		ClearTextOnFocus = false,
		ZIndex = 7,
	})
	addCorner(box, 5)
	addStroke(box, Theme.Outline)

	local function setValue(v, silent)
		box.Text = tostring(v)
		if not silent then changed:Fire(v) end
	end

	box.FocusLost:Connect(function() changed:Fire(box.Text) end)
	if config.Callback then changed:Connect(config.Callback) end

	obj.Instance = box
	obj.SetValue = function(_, t) setValue(t) end
	obj.GetValue = function() return box.Text end
	obj.SetText = obj.SetValue
	obj.GetText = obj.GetValue
	obj.OnChanged = function(_, fn) return changed:Connect(fn) end

	Tooltip.attach(holder, config.Tooltip)
	self:_registerFlag(config, obj, "textbox")

	return obj
end

-----------------------------------------------------------
-- Keybind
-----------------------------------------------------------
function TabMethods:CreateKeybind(config)
	config = config or {}
	local value = config.Default or Enum.KeyCode.RightShift
	local binding = false
	local changed = Signal.new()
	local obj = {}

	local holder = create("TextButton", {
		Parent = self:_page(),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Sizes.Element),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self:_nextOrder(),
		ZIndex = 6,
	})
	addCorner(holder, 6)
	addStroke(holder, Theme.Outline)

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.6, 0, 1, 0),
		Font = Theme.Font,
		Text = tostring(config.Text or "Keybind"),
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	local valueLabel = create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 0),
		Size = UDim2.new(0.4, 0, 1, 0),
		Font = Theme.FontBold,
		Text = "",
		TextColor3 = Theme.Accent,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 6,
	})

	local function keyName(key)
		if typeof(key) == "EnumItem" then return key.Name end
		return tostring(key)
	end

	local function setValue(key, silent)
		value = key
		obj.Value = key
		valueLabel.Text = keyName(key)
		valueLabel.TextColor3 = Theme.Accent
		if not silent then changed:Fire(key) end
	end

	holder.MouseButton1Click:Connect(function()
		binding = true
		valueLabel.Text = "..."
		valueLabel.TextColor3 = Theme.DimText
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not binding then return end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			binding = false
			setValue(input.KeyCode)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2 then
			binding = false
			setValue(input.UserInputType)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			binding = false
			setValue("Touch")
		end
	end)

	if config.Callback then changed:Connect(config.Callback) end

	obj.Instance = holder
	obj.SetValue = function(_, k) setValue(k) end
	obj.GetValue = function() return value end
	obj.OnChanged = function(_, fn) return changed:Connect(fn) end

	Tooltip.attach(holder, config.Tooltip)
	self:_registerFlag(config, obj, "keybind")

	setValue(value, true)
	return obj
end

-----------------------------------------------------------
-- Dropdown (with search)
-----------------------------------------------------------
function TabMethods:CreateDropdown(config)
	config = config or {}
	local multi   = config.Multi == true
	local changed = Signal.new()
	local obj     = {}

	local values = {}
	if config.Values then
		if #config.Values > 0 then
			for _, v in ipairs(config.Values) do table.insert(values, v) end
		else
			for k in pairs(config.Values) do table.insert(values, k) end
			table.sort(values)
		end
	end

	local selected = {}

	local function getValue()
		if multi then
			local out = {}
			for _, v in ipairs(values) do
				if selected[v] then table.insert(out, v) end
			end
			return out
		end
		for _, v in ipairs(values) do
			if selected[v] then return v end
		end
		return nil
	end

	local holder = create("TextButton", {
		Parent = self:_page(),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Sizes.Element),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self:_nextOrder(),
		ZIndex = 6,
	})
	addCorner(holder, 6)
	addStroke(holder, Theme.Outline)

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		Font = Theme.Font,
		Text = tostring(config.Text or "Dropdown"),
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	local valueLabel = create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -26, 0, 0),
		Size = UDim2.new(0.45, 0, 1, 0),
		Font = Theme.Font,
		Text = "None",
		TextColor3 = Theme.DimText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
	})

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		Font = Theme.FontBold,
		Text = "v",
		TextColor3 = Theme.DimText,
		TextSize = 12,
		ZIndex = 6,
	})

	local popup = create("Frame", {
		Parent = self.ScreenGui,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(holder.AbsoluteSize.X, 0),
		Position = UDim2.fromOffset(0, 0),
		Visible = false,
		ZIndex = 500,
		ClipsDescendants = true,
	})
	addCorner(popup, 6)
	addStroke(popup, Theme.Outline)

	local searchBox
	if config.Search then
		searchBox = create("TextBox", {
			Parent = popup,
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 24),
			BackgroundColor3 = Theme.Black,
			BorderSizePixel = 0,
			Font = Theme.Font,
			PlaceholderText = "Search...",
			PlaceholderColor3 = Theme.DimText,
			Text = "",
			TextColor3 = Theme.Text,
			TextSize = 12,
			ClearTextOnFocus = false,
			ZIndex = 501,
		})
		addCorner(searchBox, 5)
		addStroke(searchBox, Theme.Outline)
	end

	local listTop = config.Search and 34 or 0
	local listHeight = 170

	local list = create("ScrollingFrame", {
		Parent = popup,
		Position = UDim2.fromOffset(0, listTop),
		Size = UDim2.new(1, 0, 1, -listTop),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Outline,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		ZIndex = 501,
	})
	create("UIListLayout", {
		Parent = list,
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	create("UIPadding", {
		Parent = list,
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 4),
	})

	local items = {}
	local filterText = ""

	local function updateDisplay()
		if multi then
			local sel = getValue()
			if #sel == 0 then valueLabel.Text = "None"
			elseif #sel == 1 then valueLabel.Text = tostring(sel[1])
			else valueLabel.Text = tostring(sel[1]) .. " +" .. (#sel - 1) end
		else
			local v = getValue()
			valueLabel.Text = v and tostring(v) or "None"
		end
	end

	local function refreshItemVisuals()
		for _, item in ipairs(items) do
			local isSel = selected[item.Value] == true
			item.Frame.BackgroundColor3 = isSel and Theme.ElementHi or Theme.Element
			item.Frame.BackgroundTransparency = isSel and 0 or 1
			item.Label.TextColor3 = isSel and Theme.Accent or Theme.DimText
		end
	end

	local function applyFilter()
		for _, item in ipairs(items) do
			local match = filterText == ""
				or string.find(string.lower(tostring(item.Value)), string.lower(filterText), 1, true)
			item.Frame.Visible = match and true or false
		end
	end

	local function rebuild()
		for _, item in ipairs(items) do item.Frame:Destroy() end
		items = {}

		for i, val in ipairs(values) do
			local item = create("TextButton", {
				Parent = list,
				BackgroundColor3 = Theme.Element,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, Sizes.Row),
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = i,
				ZIndex = 502,
			})
			addCorner(item, 5)

			local lbl = create("TextLabel", {
				Parent = item,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -16, 1, 0),
				Font = Theme.Font,
				Text = tostring(val),
				TextColor3 = Theme.DimText,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 502,
			})

			item.MouseEnter:Connect(function()
				if not selected[val] then item.BackgroundTransparency = 0.5 end
			end)
			item.MouseLeave:Connect(function()
				if not selected[val] then item.BackgroundTransparency = 1 end
			end)

			item.MouseButton1Click:Connect(function()
				if multi then
					selected[val] = not selected[val] or nil
				else
					selected = { [val] = true }
					closeActivePopup()
				end
				updateDisplay()
				refreshItemVisuals()
				changed:Fire(getValue())
			end)

			table.insert(items, { Frame = item, Label = lbl, Value = val })
		end

		refreshItemVisuals()
		applyFilter()
	end

	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			filterText = searchBox.Text
			applyFilter()
		end)
	end

	local function open()
		closeActivePopup()
		rebuild()
		if searchBox then searchBox.Text = "" end
		filterText = ""

		local visibleCount = 0
		for _, v in ipairs(values) do visibleCount = visibleCount + 1 end
		local baseH = math.min(visibleCount * (Sizes.Row + 2) + 8, listHeight)
		local totalH = baseH + (config.Search and 34 or 0)

		popup.Size = UDim2.fromOffset(holder.AbsoluteSize.X, math.max(totalH, 34))

		local vp = viewport()
		local px = holder.AbsolutePosition.X
		local py = holder.AbsolutePosition.Y + holder.AbsoluteSize.Y + 2
		if py + popup.AbsoluteSize.Y > vp.Y then
			py = holder.AbsolutePosition.Y - popup.AbsoluteSize.Y - 2
		end
		if px + popup.AbsoluteSize.X > vp.X then
			px = vp.X - popup.AbsoluteSize.X - 4
		end
		px = math.max(px, 4)
		py = math.max(py, 4)

		popup.Position = UDim2.fromOffset(px, py)
		popup.Visible = true

		ActivePopup = function() popup.Visible = false end
	end

	local function close()
		popup.Visible = false
		if ActivePopup then ActivePopup = nil end
	end

	holder.MouseButton1Click:Connect(function()
		if popup.Visible then close() else open() end
	end)
	holder.MouseEnter:Connect(function()
		tween(holder, { BackgroundColor3 = Theme.ElementHi })
	end)
	holder.MouseLeave:Connect(function()
		tween(holder, { BackgroundColor3 = Theme.Element })
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not popup.Visible then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local pos = input.Position
		local function inside(gui)
			local ap, as = gui.AbsolutePosition, gui.AbsoluteSize
			return pos.X >= ap.X and pos.X <= ap.X + as.X
				and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
		end
		if not inside(holder) and not inside(popup) then close() end
	end)

	self:_page():GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if popup.Visible then close() end
	end)

	if config.Default ~= nil then
		if multi and type(config.Default) == "table" then
			for _, v in ipairs(config.Default) do selected[v] = true end
		elseif not multi then
			selected[config.Default] = true
		end
	end

	if config.Callback then changed:Connect(config.Callback) end

	updateDisplay()

	obj.Instance = holder
	obj.GetValue = function() return getValue() end
	obj.SetValue = function(_, v)
		selected = {}
		if multi and type(v) == "table" then
			for _, x in ipairs(v) do selected[x] = true end
		elseif v ~= nil then
			selected[v] = true
		end
		updateDisplay()
		refreshItemVisuals()
		changed:Fire(getValue())
	end
	obj.Refresh = function(_, newValues)
		if newValues then
			values = {}
			for _, v in ipairs(newValues) do table.insert(values, v) end
		end
		updateDisplay()
		if popup.Visible then rebuild() end
	end
	obj.OnChanged = function(_, fn) return changed:Connect(fn) end

	Tooltip.attach(holder, config.Tooltip)
	self:_registerFlag(config, obj, "dropdown")

	return obj
end

-----------------------------------------------------------
-- Color Picker (with hex)
-----------------------------------------------------------
function TabMethods:CreateColorPicker(config)
	config = config or {}
	local color   = config.Default or Color3.fromRGB(255, 255, 255)
	local changed = Signal.new()
	local obj     = {}

	local h, s, v = Color3.toHSV(color)

	local holder = create("TextButton", {
		Parent = self:_page(),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Sizes.Element),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self:_nextOrder(),
		ZIndex = 6,
	})
	addCorner(holder, 6)
	addStroke(holder, Theme.Outline)

	create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.6, 0, 1, 0),
		Font = Theme.Font,
		Text = tostring(config.Text or "Color"),
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	local swatch = create("Frame", {
		Parent = holder,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(44, 18),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 6,
	})
	addCorner(swatch, 5)
	addStroke(swatch, Theme.Accent)

	local popup = create("Frame", {
		Parent = self.ScreenGui,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(220, 178),
		Visible = false,
		ZIndex = 500,
	})
	addCorner(popup, 8)
	addStroke(popup, Theme.Outline)
	create("UIPadding", {
		Parent = popup,
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	})
	create("UIListLayout", {
		Parent = popup,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local preview = create("Frame", {
		Parent = popup,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 1,
		ZIndex = 501,
	})
	addCorner(preview, 6)
	addStroke(preview, Theme.Outline)

	local hueBar, hueKnob = makeMiniSlider(popup, 2, "Hue",
		{ Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 0, 255) })
	local satBar, satKnob, satGradient = makeMiniSlider(popup, 3, "Saturation",
		{ Color3.fromRGB(128, 128, 128), Color3.fromRGB(255, 255, 255) })
	local valBar, valKnob, valGradient = makeMiniSlider(popup, 4, "Value",
		{ Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255) })

	local hexBox = create("TextBox", {
		Parent = popup,
		BackgroundColor3 = Theme.Black,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 22),
		Font = Theme.Font,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 12,
		ClearTextOnFocus = false,
		LayoutOrder = 5,
		ZIndex = 501,
	})
	addCorner(hexBox, 5)
	addStroke(hexBox, Theme.Outline)

	local function colorToHex(c)
		local r = math.floor(c.R * 255 + 0.5)
		local g = math.floor(c.G * 255 + 0.5)
		local b = math.floor(c.B * 255 + 0.5)
		return string.format("#%02X%02X%02X", r, g, b)
	end

	local function hexToColor(hex)
		hex = hex:gsub("#", "")
		if #hex ~= 6 then return nil end
		local r = tonumber(hex:sub(1, 2), 16)
		local g = tonumber(hex:sub(3, 4), 16)
		local b = tonumber(hex:sub(5, 6), 16)
		if not (r and g and b) then return nil end
		return Color3.fromRGB(r, g, b)
	end

	local function refresh(silent)
		color = Color3.fromHSV(h, s, v)
		obj.Value = color

		preview.BackgroundColor3 = color
		swatch.BackgroundColor3 = color
		hexBox.Text = colorToHex(color)

		hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
		satKnob.Position = UDim2.new(s, 0, 0.5, 0)
		valKnob.Position = UDim2.new(v, 0, 0.5, 0)

		if satGradient then
			satGradient.Color = ColorSequence.new(
				Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
		end
		if valGradient then
			valGradient.Color = ColorSequence.new(
				Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1))
		end

		if not silent then changed:Fire(color) end
	end

	local function bindDrag(bar, setter)
		local dragging = false
		local function update(input)
			local width = bar.AbsoluteSize.X
			if width <= 0 then return end
			local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / width, 0, 1)
			setter(rel)
			refresh()
		end
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				update(input)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				update(input)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

	bindDrag(hueBar, function(rel) h = rel end)
	bindDrag(satBar, function(rel) s = rel end)
	bindDrag(valBar, function(rel) v = rel end)

	hexBox.FocusLost:Connect(function()
		local c = hexToColor(hexBox.Text)
		if c then
			h, s, v = Color3.toHSV(c)
			refresh()
		else
			hexBox.Text = colorToHex(color)
		end
	end)

	local function close()
		popup.Visible = false
		if ActivePopup then ActivePopup = nil end
	end

	local function open()
		closeActivePopup()
		local pos = holder.AbsolutePosition
		local size = holder.AbsoluteSize
		local vp = viewport()
		local px = math.clamp(pos.X, 0, math.max(vp.X - popup.AbsoluteSize.X, 0))
		local py = pos.Y + size.Y + 4
		if py + popup.AbsoluteSize.Y > vp.Y then
			py = pos.Y - popup.AbsoluteSize.Y - 4
		end
		popup.Position = UDim2.fromOffset(px, py)
		popup.Visible = true
		ActivePopup = function() popup.Visible = false end
	end

	holder.MouseButton1Click:Connect(function()
		if popup.Visible then close() else open() end
	end)
	holder.MouseEnter:Connect(function()
		tween(holder, { BackgroundColor3 = Theme.ElementHi })
	end)
	holder.MouseLeave:Connect(function()
		tween(holder, { BackgroundColor3 = Theme.Element })
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not popup.Visible then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local pos = input.Position
		local function inside(gui)
			local ap, as = gui.AbsolutePosition, gui.AbsoluteSize
			return pos.X >= ap.X and pos.X <= ap.X + as.X
				and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
		end
		if not inside(holder) and not inside(popup) then close() end
	end)

	self:_page():GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if popup.Visible then close() end
	end)

	if config.Callback then changed:Connect(config.Callback) end

	obj.Instance = holder
	obj.Value = color
	obj.GetValue = function() return color end
	obj.SetValue = function(_, c)
		h, s, v = Color3.toHSV(c)
		refresh()
	end
	obj.OnChanged = function(_, fn) return changed:Connect(fn) end

	Tooltip.attach(holder, config.Tooltip)
	self:_registerFlag(config, obj, "colorpicker")

	refresh(true)
	return obj
end

